{
  "compilerOptions": {
    /* Layout de Archivos */
    "rootDir": "./src",
    "outDir": "./dist",
    /* Configuración de Entorno y Módulos */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    /* Path Aliases (Rutas Absolutas) */
    "baseUrl": "./src",
    "paths": {
      "@app/*": [
        "app/*"
      ],
      "@modules/*": [
        "modules/*"
      ],
      "@domain/*": [
        "domain/*"
      ],
      "@application/*": [
        "application/*"
      ],
      "@infrastructure/*": [
        "infrastructure/*"
      ],
      "@presentation/*": [
        "presentation/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    },
    /* Salidas de Tipos y Mapas */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    /* Estricto y Seguridad */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* Interoperabilidad y Emisión */
    "esModuleInterop": true,
    "moduleDetection": "force"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}